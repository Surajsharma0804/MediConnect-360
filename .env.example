# MediConnect 360 - Environment Variables
# 💰 COST-EFFECTIVE SETUP: Build your MVP for FREE!
# See COST_EFFECTIVE_SETUP.md for detailed explanations

# ======================
# FRONTEND (.env)
# ======================

VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
VITE_ENV=development

# ======================
# BACKEND (backend/.env)
# ======================

# --- SERVER ---
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# --- DATABASE (Choice 1-a: Local via Docker) ---
# The user/pass here matches the docker-compose file
DATABASE_URL=postgresql://postgres:password@localhost:5432/mediconnect
REDIS_URL=redis://localhost:6379
MONGODB_URI=mongodb://localhost:27017/mediconnect

# --- AUTH (JWT) ---
JWT_SECRET=super-secret-dev-key-change-in-production-123
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super-secret-refresh-key-456
JWT_REFRESH_EXPIRES_IN=30d

# --- AI INTELLIGENCE (Choice 2-a: Google Gemini - FREE!) ---
# ✅ FREE: 60 requests/minute, no credit card needed
# Get your free key: https://aistudio.google.com/app/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=paste-your-free-gemini-key-here

# Alternative: OpenAI (if you prefer, but costs $$$)
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4-turbo-preview

# --- FILE STORAGE (Choice 3-a: MinIO - FREE Local S3) ---
# ✅ FREE: Self-hosted, S3-compatible storage
# MinIO runs in Docker and acts exactly like AWS S3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=mediconnect-files
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:9000
# Note: Set 's3ForcePathStyle: true' in your AWS SDK config

# Alternative: Real AWS S3 (when you scale)
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_ENDPOINT= (leave empty for real AWS)

# --- VIDEO CALLS (Choice 4-a: Jitsi - FREE!) ---
# ✅ FREE: Open-source, no per-minute charges
# Use public Jitsi: https://meet.jit.si/mediconnect-{roomId}
VIDEO_PROVIDER=jitsi
JITSI_DOMAIN=meet.jit.si

# Alternative: Twilio (when you need enterprise features)
# VIDEO_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_API_KEY=your-api-key
# TWILIO_API_SECRET=your-api-secret

# --- SMS (Choice 5-a: Console Log for Development) ---
# ✅ FREE: Just logs to console during development
# Perfect for testing without spending money on SMS
SMS_PROVIDER=console_log

# Alternative: Real SMS (when you launch)
# SMS_PROVIDER=twilio
# TWILIO_PHONE_NUMBER=+1234567890

# --- EMAIL (Choice 6-a: Resend - FREE 3,000/month) ---
# ✅ FREE: 3,000 emails/month, no credit card to start
# Get your free key: https://resend.com/api-keys
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_123456789_paste_your_key_here
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=MediConnect 360

# Alternative: Brevo (formerly Sendinblue) - FREE 300/day
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=your-brevo-key
# FROM_EMAIL=noreply@mediconnect360.com

# --- PAYMENTS (Stripe Test Mode - FREE for testing) ---
# ✅ FREE: Use test keys, no real charges
# Get test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_paste_your_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_paste_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_paste_your_webhook_secret

# --- GOOGLE OAUTH ---
# Get credentials: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# --- SECURITY ---
ENCRYPTION_KEY=must-be-exactly-32-characters!!
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# --- RATE LIMITING ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- FILE UPLOAD ---
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# --- LOGGING ---
LOG_LEVEL=debug
LOG_FORMAT=json

# --- FEATURE FLAGS ---
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_2FA=false
ENABLE_VIDEO_RECORDING=false
ENABLE_AI_DIAGNOSTICS=true

# ======================
# DOCKER CONFIGURATION
# ======================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mediconnect

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=mediconnect

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ======================
# PRODUCTION OVERRIDES
# ======================

# When deploying to production, change these:
# NODE_ENV=production
# DATABASE_URL=postgresql://user:pass@prod-host:5432/mediconnect
# JWT_SECRET=use-a-strong-random-secret
# ENCRYPTION_KEY=use-a-strong-32-char-key
# CORS_ORIGIN=https://mediconnect360.com
# API_URL=https://api.mediconnect360.com
# VITE_API_URL=https://api.mediconnect360.com

# Consider upgrading to paid services:
# - Gemini → OpenAI (better medical accuracy)
# - MinIO → AWS S3 (global CDN)
# - Jitsi public → Self-hosted Jitsi (custom branding)
# - Console SMS → Twilio (real SMS)
# - Resend free → Resend Pro (more emails)

# ======================
# 💰 COST SUMMARY
# ======================

# Development (Local):
# - Everything: FREE ($0/month)
# - Docker containers: FREE
# - Gemini API: FREE (60 req/min)
# - MinIO: FREE (self-hosted)
# - Jitsi: FREE (public instance)
# - Resend: FREE (3,000 emails/month)
# - Console SMS: FREE (logs only)

# Production (1,000 users):
# - VPS hosting: $20/month
# - Domain + SSL: $1/month
# - Everything else: FREE
# - Total: ~$21/month

# Production (10,000 users):
# - VPS hosting: $40/month
# - Resend Pro: $20/month
# - Backups: $5/month
# - Total: ~$65/month

# Compare to traditional setup:
# - OpenAI: $300/month
# - AWS S3: $50/month
# - Twilio Video: $200/month
# - SendGrid: $50/month
# - SMS: $50/month
# - Traditional Total: $650/month
# - Your Total: $0-65/month
# - Savings: $585-650/month! 🎉

# ======================
# 🚀 QUICK START
# ======================

# 1. Copy this file:
#    cp .env.example .env
#    cp .env.example backend/.env

# 2. Get FREE API keys:
#    - Gemini: https://aistudio.google.com/app/apikey
#    - Resend: https://resend.com/api-keys
#    - Google OAuth: https://console.cloud.google.com/apis/credentials
#    - Stripe Test: https://dashboard.stripe.com/test/apikeys

# 3. Start Docker services:
#    docker-compose up -d

# 4. Start development:
#    cd backend && npm run start:dev
#    npm run dev

# 5. Access services:
#    - Frontend: http://localhost:5173
#    - Backend: http://localhost:5000
#    - MinIO Console: http://localhost:9001 (minioadmin/minioadmin)
#    - PostgreSQL: localhost:5432 (postgres/password)

