# ═══════════════════════════════════════════════════════════════════
# MediConnect 360 — Backend Environment Variables
# ═══════════════════════════════════════════════════════════════════
# ⚠️ NEVER commit this file. Add to .gitignore!
# Generate secrets with: openssl rand -base64 32

# ─── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# ─── Database ────────────────────────────────────────────────────
# ⚠️ Change passwords in production!
DATABASE_URL=postgresql://postgres:password@localhost:5432/mediconnect
REDIS_URL=redis://localhost:6379

# ─── Authentication ──────────────────────────────────────────────
# ⚠️ CRITICAL: Generate strong secrets for production
# openssl rand -base64 32
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_use_openssl_rand
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_2
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback

# ─── AI Provider ─────────────────────────────────────────────────
# Gemini: FREE 60 req/min — https://aistudio.google.com/app/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=paste-your-free-gemini-key-here
# Alternative: OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key

# ─── File Storage ────────────────────────────────────────────────
# MinIO (local S3-compatible) or real AWS S3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=mediconnect-files
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:9000

# ─── Video Calls ─────────────────────────────────────────────────
VIDEO_PROVIDER=jitsi
JITSI_DOMAIN=meet.jit.si

# ─── Email ───────────────────────────────────────────────────────
# Resend: FREE 3,000/month — https://resend.com/api-keys
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_paste_your_key_here
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=MediConnect 360

# ─── SMS ─────────────────────────────────────────────────────────
SMS_PROVIDER=console_log
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your-sid
# TWILIO_AUTH_TOKEN=your-token
# TWILIO_PHONE_NUMBER=+1234567890

# ─── Payments ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_paste_your_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_paste_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_paste_your_webhook_secret

# ─── Security ────────────────────────────────────────────────────
# Must be exactly 32 chars for AES-256: openssl rand -hex 16
ENCRYPTION_KEY=CHANGE_ME_must_be_32_characters!

# ─── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── File Upload ─────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json

# ─── Feature Flags ───────────────────────────────────────────────
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_2FA=false
ENABLE_VIDEO_RECORDING=false
ENABLE_AI_DIAGNOSTICS=true

# ─── Docker Services ─────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mediconnect
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
